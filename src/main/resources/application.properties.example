spring.application.name=apex-institute

# --- SQL Server ---
spring.datasource.url=jdbc:sqlserver://localhost\\SQLEXPRESS;databaseName=ApexInstitute01;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=YOUR_SECRET_HERE
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

# --- JPA ---
# none = Hibernate never touches your schema. We created tables in SSMS.
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.SQLServerDialect
# Don't write entity names as quoted ? keeps table/column names as we defined them
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.servlet.multipart.max-file-size=100MB
spring.servlet.multipart.max-request-size=100MB

# --- Server ---
server.port=8080

# --- JWT ---
# Must be 32+ chars. Change this to anything random for the demo.
apex.jwt.secret=YOUR_SECRET_HERE
apex.jwt.expiration-ms=86400000

# --- CORS ---
apex.cors.allowed-origins=http://localhost:5500,http://127.0.0.1:5500,file://